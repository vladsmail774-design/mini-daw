{
  "name": "mini-daw",
  "private": true,
  "version": "2.1.0",
  "description": "Mini DAW — desktop audio editor (Electron + Web Audio)",
  "author": "mini-daw",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run desktop",
    "dev": "vite",
    "desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:portable": "npm run build && node scripts/package-portable.mjs",
    "portable": "npm run electron:portable",
    "electron:dist": "npm run build && electron-builder",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "check": "npm run lint && npm test && npm run build",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.1",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
